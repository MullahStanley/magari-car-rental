# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored and contains secrets.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# "Publishable" (anon) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Server-side only — never commit, never ship to the browser.
# Required by scripts/upload-models.mjs to deploy models to the vehicle-assets bucket.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Didit KYC ───────────────────────────────────────────────────────────────
# Server-side only — identity verification (src/app/api/verify + webhook)
DIDIT_API_KEY=your-didit-api-key
DIDIT_WEBHOOK_SECRET=your-didit-webhook-secret

# ── Cloudflare CDN ──────────────────────────────────────────────────────────
# Optional: Cloudflare CDN domain or Cloudflare Worker URL
# e.g., https://cdn.yourdomain.com or https://magari-assets-cdn.<subdomain>.workers.dev
# When set, all 3D vehicle models (.glb) and vehicle images route through Cloudflare edge cache.
# When empty, seamlessly falls back to NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_CDN_URL=

# Optional: Cloudflare API credentials for scripts/purge-cdn-cache.mjs
# Find in Cloudflare Dashboard → Manage Account → API Tokens / Zone Overview
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=


