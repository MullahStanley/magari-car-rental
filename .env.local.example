# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored and contains secrets.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# "Publishable" (anon) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Server-side only — never commit, never ship to the browser.
# Required by scripts/upload-models.mjs to deploy models to the vehicle-assets bucket.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Didit KYC ───────────────────────────────────────────────────────────────
# Server-side only — identity verification (src/app/api/verify + webhook)
DIDIT_API_KEY=your-didit-api-key
DIDIT_WEBHOOK_SECRET=your-didit-webhook-secret

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
